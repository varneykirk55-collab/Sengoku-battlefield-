; Engine configuration file.
; Sengoku Battlefield - Godot 4.7.2 (Standard build, GDScript).

config_version=5

[application]

config/name="Sengoku Battlefield"
config/description="Single-player, Battlefield-style Sengoku-era combat: one soldier among two AI armies."
config/version="0.6.0-m6"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Settings="*res://autoload/settings.gd"
GameInput="*res://autoload/game_input.gd"
Events="*res://autoload/events.gd"
AudioManager="*res://autoload/audio_manager.gd"
Music="*res://autoload/music_manager.gd"
FX="*res://autoload/fx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

naming/default_signal_callback_name="_on_{node_name}_{signal_name}"

[filesystem]

import/blender/enabled=false

[navigation]

3d/default_cell_size=0.4
3d/default_cell_height=0.2

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=1
; MSAA off: MSAA + SSAO/SSIL produced black tiles over terrain on AMD (RX 560X) Vulkan.
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=2
